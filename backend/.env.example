# Copy to .env locally. Replace every placeholder before starting the service.
# Never commit the real .env file.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
JWT_SECRET=replace-with-at-least-32-random-bytes-in-hex
DATABASE_URL=
# DATABASE_URL takes precedence when set; leave empty for local SQLite.
DATABASE_PATH=./nova.sqlite3
TOKEN_TTL_MINUTES=30

# Optional Vox partner key; set only in the backend secret manager.
VOX_API_KEY=
